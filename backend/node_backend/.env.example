# MongoDB Connection URI (Document Storage for Contracts, Cases, Chats)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.vsfoj91.mongodb.net/legalData
MONGODB_PASSWORD=your_mongodb_password

# MySQL Database Configuration (User Authentication)
SQL_HOST=127.0.0.1
SQL_USER=root
SQL_PASSWORD=your_mysql_password
SQL_DATABASE=users

# Node Backend Port
PORT=5000

# JWT Authentication Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_key_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_key_here
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

