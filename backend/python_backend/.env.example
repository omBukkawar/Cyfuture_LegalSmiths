# Python FastAPI Server Configuration
PORT=8000
HOST=0.0.0.0
INDEX_DIR=./data/indexes
DEVICE=auto

# CORS — comma-separated list of allowed frontend/node origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000,https://legalsmiths.onrender.com,https://legalsmiths-node.onrender.com

# Pipeline timeouts (seconds) — increase on slow hardware
LEGAL_ASSISTANT_TIMEOUT=90
CONTRACT_ANALYZER_TIMEOUT=180
CASE_PREDICTOR_TIMEOUT=180
# Serper.dev API Key (Google India Geotargeted Legal Search)
SERPER_API_KEY=your_serper_api_key_here

# OpenRouter API Key & Base URL
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-Module Model Configuration (High rate limits, non-Chinese, enterprise-grade)
# Legal Assistant: Meta Llama 3.3 70B (Deep statutory reasoning & high concurrency)
# Fallbacks: openai/gpt-4o-mini -> mistralai/mistral-small-24b -> nvidia/nemotron-3.5-lightning:free
LEGAL_ASSISTANT_MODEL=meta-llama/llama-3.3-70b-instruct

# Contract Analyzer: OpenAI GPT-4o-mini (Flawless strict JSON schema parsing & liability auditing)
# Fallbacks: meta-llama/llama-3.3-70b -> mistralai/mistral-small-24b -> nvidia/nemotron-3.5-lightning:free
CONTRACT_ANALYZER_MODEL=openai/gpt-4o-mini

# Case Predictor: Meta Llama 3.3 70B (Judicial precedent reasoning & court balancing)
# Fallbacks: openai/gpt-4o-mini -> mistralai/mistral-small-24b -> nvidia/nemotron-3-ultra-550b-a55b:free
CASE_PREDICTOR_MODEL=meta-llama/llama-3.3-70b-instruct

# LangGraph Adversarial Debate Pipeline (Case Outcome Prediction)
# ADVOCATE_MODEL: used for claimant/defence/rebuttal advocate calls
# JUDGE_MODEL: cross-model evaluator that produces the structured JSON verdict
ADVOCATE_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
ADVOCATE_FALLBACK_1=google/gemma-4-31b-it:free
JUDGE_MODEL=google/gemma-4-26b-a4b-it:free

# Global Fallback Model
OPENROUTER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct
