# Python FastAPI Server Configuration
PORT=8000
HOST=0.0.0.0
INDEX_DIR=./data/indexes
DEVICE=auto

# Serper.dev API Key (Google India Geotargeted Legal Search)
SERPER_API_KEY=your_serper_api_key_here

# OpenRouter API Key & Base URL
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-Module Model Configuration
# Free auto-router (default, zero 404s): openrouter/auto
# Or specify individual models e.g., google/gemma-4-31b-it:free, qwen/qwen-2.5-72b-instruct:free, deepseek/deepseek-r1:free
LEGAL_ASSISTANT_MODEL=openrouter/auto
CONTRACT_ANALYZER_MODEL=openrouter/auto
CASE_PREDICTOR_MODEL=openrouter/auto

# Global Fallback Model
OPENROUTER_MODEL_NAME=openrouter/auto
